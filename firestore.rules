rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidVisitorId(vid) {
      return vid is string
        && vid.size() >= 12
        && vid.size() <= 128;
    }

    match /conversations/{visitorId} {
      allow get, list: if isValidVisitorId(visitorId);
      allow create, update: if isValidVisitorId(visitorId)
        && request.resource.data.keys().size() <= 35;
      allow delete: if isValidVisitorId(visitorId);

      match /messages/{messageId} {
        allow get, list: if isValidVisitorId(visitorId);
        allow create, update: if isValidVisitorId(visitorId)
          && messageId.size() >= 6
          && messageId.size() <= 128
          && request.resource.data.keys().size() <= 20;
        allow delete: if isValidVisitorId(visitorId);
      }
    }

    match /presence/{visitorId} {
      allow get, list, create, update, delete: if isValidVisitorId(visitorId);
    }

    match /chat_admins/{uid} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
