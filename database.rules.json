{
  "rules": {
    ".read": false,
    ".write": false,
    "posts": {
      ".read": true,
      ".write": true
    },
    "gallery": {
      ".read": true,
      ".write": true
    },
    "about": {
      ".read": true,
      ".write": true
    },
    "homepage": {
      ".read": true,
      ".write": true
    },
    "settings": {
      ".read": true,
      ".write": true
    },
    "presence": {
      ".read": true,
      ".write": true
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'chitronbhattacharjee@gmail.com')",
        ".write": "auth != null && auth.token.email === 'chitronbhattacharjee@gmail.com'"
      }
    },
    "conversations": {
      ".read": "auth != null && (auth.token.email === 'chitronbhattacharjee@gmail.com' || root.child('admins').child(auth.uid).exists())",
      "$visitorId": {
        ".read": "$visitorId.matches(/^visitor_[a-zA-Z0-9_-]{12,64}$/) || (auth != null && (auth.token.email === 'chitronbhattacharjee@gmail.com' || root.child('admins').child(auth.uid).exists()))",
        ".write": "($visitorId.matches(/^visitor_[a-zA-Z0-9_-]{12,64}$/) && newData.exists() && newData.child('visitorId').val() === $visitorId && (!data.exists() || data.child('status').val() !== 'blocked')) || (auth != null && (auth.token.email === 'chitronbhattacharjee@gmail.com' || root.child('admins').child(auth.uid).exists()))",
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['messageId', 'visitorId', 'sender', 'text', 'timestamp', 'type', 'read']) && newData.child('messageId').val() === $messageId && newData.child('visitorId').val() === $visitorId && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000 && (newData.child('sender').val() === 'visitor' || (newData.child('sender').val() === 'admin' && auth != null))"
          }
        }
      }
    }
  }
}
